+.auth-card { width: 100%; max-width: 440px; padding: 36px; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 24px; box-shadow: var(--shadow-lg); animation: fadeIn .4s var(--ease-out); }
+.auth-card > .brand-wordmark { display: flex; justify-content: center; }.auth-heading { text-align: center; margin: 28px 0; }.auth-kicker { font-size: 8px; font-weight: 700; color: var(--brand-primary); letter-spacing: .16em; }.auth-heading h1 { font-size: 32px; line-height: 1.1; margin: 10px 0; }.auth-heading p { font-size: 12px; line-height: 1.7; color: var(--text-secondary); max-width: 290px; margin-inline: auto; }.auth-google { width: 100%; min-height: 46px; font-size: 13px; }.auth-divider { display: flex; align-items: center; gap: 14px; color: var(--text-muted); font-size: 9px; letter-spacing: .12em; margin: 24px 0; }.auth-divider::before, .auth-divider::after { content: ''; height: 1px; flex: 1; background: var(--border-subtle); }
