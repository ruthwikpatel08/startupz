+.auth-stage { min-height: 100dvh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 90px 20px 40px; background: radial-gradient(ellipse at 15% 15%, color-mix(in srgb, var(--brand-primary) 8%, transparent), transparent 40%), radial-gradient(ellipse at 90% 80%, #b6d96512, transparent 45%), var(--bg-primary); position: relative; isolation: isolate; }
