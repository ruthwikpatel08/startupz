+.hookz-product > header { background: var(--bg-surface); border-color: var(--border-subtle); }
+.hookz-product > header .brand-wordmark { font-size: 24px; }
+.hookz-product aside { background: var(--bg-surface); border-color: var(--border-subtle); padding: 28px 16px; }
 .hookz-product aside a { border-radius: var(--radius-md); min-height: 44px; }
-.hookz-product .card-base { border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
-.hookz-product :is(input:not([type=checkbox]):not([type=radio]), select, textarea) { border-color: var(--border-subtle); border-radius: var(--radius-md); background-color: var(--bg-surface); color: var(--text-primary); }
-.hookz-product :is(input, select, textarea):focus-visible { outline: 2px solid var(--brand-primary); outline-offset: 2px; }
-.hookz-product :is(.btn-primary, .btn-secondary) { min-height: 40px; border-radius: var(--radius-md); }
-.hookz-product :is(h1, h2, h3) { font-family: var(--font-display); }
-.hookz-product main > div > .max-w-7xl { padding-top: 32px; }
+.hookz-product aside a[aria-current=page] { background: var(--brand-soft); color: var(--brand-primary); box-shadow: none; }
+.hookz-product aside a[aria-current=page] svg { color: inherit; }
+.hookz-product main { background: var(--bg-primary); }
+.hookz-product :is(h1, h2, h3), .hookz-product-overlay :is(h2, h3) { font-family: var(--font-display); letter-spacing: -.035em; }
+.hookz-product main h1, .hookz-product .product-page-title, .product-home > section:first-of-type h2 { font-size: clamp(28px, 3vw, 38px); font-weight: 750; line-height: 1.12; letter-spacing: -.045em; }
+.hookz-product :is(.card-base, .product-feature) { border-radius: var(--radius-lg); border: 1px solid var(--border-subtle); box-shadow: var(--shadow-sm); }
+.hookz-product .card-base:hover { box-shadow: var(--shadow-md); }
+.hookz-product .product-feature { background: var(--brand-soft); color: var(--text-primary); border-radius: 20px; }
+.hookz-product .product-cover { background: linear-gradient(115deg, var(--brand-soft), color-mix(in srgb, var(--secondary) 45%, var(--bg-surface)), color-mix(in srgb, var(--accent) 40%, var(--bg-surface))); }
+.hookz-product :is(.shadow-xl, .shadow-2xl, .shadow-lg) { box-shadow: var(--shadow-md); }
